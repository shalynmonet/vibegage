{
  "name": "vibegage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -r dotenv/config --import tsx --watch src/server/index.ts",
    "sim": "node -r dotenv/config --import tsx scripts/simulate.ts",
    "build": "tsc -p tsconfig.json && node --import tsx scripts/copy-assets.ts",
    "start": "node -r dotenv/config dist/src/server/index.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.0",
    "openai": "^4.85.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
